{
  "$description": "Semantic layer, light theme (ivory ground, ink text). Surfaces step bg < surface < surface-raised < surface-overlay; hover/selected are derived fg overlays (build.mjs). Status hues (success/warning/danger/info) never change per brand and never equal the brand accent.",
  "semantic": {
    "$type": "color",
    "bg":                { "$value": "{color.ivory.200}" },
    "surface":           { "$value": "{color.ivory.100}" },
    "surface-raised":    { "$value": "{color.ivory.50}" },
    "surface-overlay":   { "$value": "{color.ivory.25}" },
    "surface-soft":      { "$value": "{color.ivory.300}" },
    "line":              { "$value": "{color.ivory.400}" },
    "line-strong":       { "$value": "{color.ivory.450}" },
    "fg":                { "$value": "{color.ink.900}" },
    "fg-body":           { "$value": "{color.ivory.700}" },
    "fg-muted":          { "$value": "{color.ivory.600}" },
    "accent":            { "$value": "{color.gold.500}" },
    "accent-text":       { "$value": "{color.gold.700}" },
    "focus":             { "$value": "{color.ink.900}" },
    "success":           { "$value": "{color.green.500}" },
    "success-text":      { "$value": "{color.green.700}" },
    "warning":           { "$value": "{color.amber.500}" },
    "warning-text":      { "$value": "{color.amber.700}" },
    "danger":            { "$value": "{color.red.500}" },
    "danger-text":       { "$value": "{color.red.700}" },
    "danger-solid":      { "$value": "{color.red.700}" },
    "on-danger":         { "$value": "{color.white}" },
    "info":              { "$value": "{color.blue.500}" },
    "info-text":         { "$value": "{color.blue.700}" }
  }
}
