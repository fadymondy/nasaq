{
  "$description": "Nasaq primitive layer. Values inherited from fmv2 'the grid' (grid-tokens.css). Only the semantic layer may reference these.",
  "color": {
    "$type": "color",
    "ink":   { "950": { "$value": "#0B1429" }, "900": { "$value": "#0E1A3C" }, "875": { "$value": "#132147" }, "850": { "$value": "#18264A" }, "825": { "$value": "#1B2A52" }, "800": { "$value": "#1A2747" }, "700": { "$value": "#25355C" }, "500": { "$value": "#8A97B8" }, "300": { "$value": "#C8D0E4" } },
    "ivory": { "25": { "$value": "#FDFCF9" }, "50": { "$value": "#FAF8F3" }, "100": { "$value": "#F7F4EC" }, "200": { "$value": "#F0EBE1" }, "300": { "$value": "#EDE7DB" }, "400": { "$value": "#DED5C4" }, "450": { "$value": "#C7BEA9" }, "600": { "$value": "#6E6551" }, "700": { "$value": "#4A4438" } },
    "white": { "$value": "#FFFFFF" },
    "gold":   { "500": { "$value": "#C9A227" }, "700": { "$value": "#7D6310" } },
    "orange": { "600": { "$value": "#E2661C" } },
    "green":  { "300": { "$value": "#6FBF5E" }, "500": { "$value": "#4E9A3E" }, "700": { "$value": "#33702A" } },
    "red":    { "300": { "$value": "#E8788C" }, "500": { "$value": "#D9455F" }, "700": { "$value": "#A8233B" } },
    "amber":  { "300": { "$value": "#F2B85C" }, "500": { "$value": "#E0931A" }, "700": { "$value": "#8A5300" } },
    "blue":   { "300": { "$value": "#8DB4F5" }, "500": { "$value": "#4A84E0" }, "700": { "$value": "#1F55A8" } },
    "tag": {
      "$description": "Functional categorical palette for user-chosen labels (from Mahaam --pal-*). Not a brand palette.",
      "gray":   { "light": { "$value": "#66708A" }, "dark": { "$value": "#A3ADC6" } },
      "red":    { "light": { "$value": "#C23A53" }, "dark": { "$value": "#EE8398" } },
      "orange": { "light": { "$value": "#D05F18" }, "dark": { "$value": "#F09A5C" } },
      "amber":  { "light": { "$value": "#B58710" }, "dark": { "$value": "#E0BF55" } },
      "green":  { "light": { "$value": "#3F8A34" }, "dark": { "$value": "#7FCB6D" } },
      "teal":   { "light": { "$value": "#0F7C80" }, "dark": { "$value": "#5EC4C6" } },
      "blue":   { "light": { "$value": "#2F6FCF" }, "dark": { "$value": "#78A8F0" } },
      "violet": { "light": { "$value": "#7B3FB0" }, "dark": { "$value": "#B784D6" } },
      "pink":   { "light": { "$value": "#C0438E" }, "dark": { "$value": "#EF8FC8" } }
    }
  },
  "space": {
    "$type": "dimension",
    "hair": { "$value": { "value": 2,  "unit": "px" } },
    "1":    { "$value": { "value": 4,  "unit": "px" } },
    "2":    { "$value": { "value": 8,  "unit": "px" } },
    "3":    { "$value": { "value": 12, "unit": "px" } },
    "4":    { "$value": { "value": 16, "unit": "px" } },
    "6":    { "$value": { "value": 24, "unit": "px" } },
    "8":    { "$value": { "value": 32, "unit": "px" } },
    "12":   { "$value": { "value": 48, "unit": "px" } },
    "16":   { "$value": { "value": 64, "unit": "px" } }
  },
  "layout": {
    "$type": "dimension",
    "rail":   { "$value": { "value": 20,  "unit": "px" } },
    "pad":    { "$value": { "value": 28,  "unit": "px" } },
    "gap":    { "$value": { "value": 16,  "unit": "px" } },
    "column": { "$value": { "value": 860, "unit": "px" } }
  },
  "window": {
    "$description": "Desktop (Electron) window chrome. titlebar = title bar height; inset = width reserved for the OS caption buttons (traffic lights on macOS, the caption overlay on Windows, drawn WindowControls on Linux).",
    "$type": "dimension",
    "titlebar": {
      "darwin": { "$value": { "value": 52, "unit": "px" } },
      "win32":  { "$value": { "value": 40, "unit": "px" } },
      "linux":  { "$value": { "value": 46, "unit": "px" } }
    },
    "inset": {
      "darwin": { "$value": { "value": 80, "unit": "px" } },
      "win32":  { "$value": { "value": 138, "unit": "px" } },
      "linux":  { "$value": { "value": 108, "unit": "px" } }
    }
  },
  "duration": { "$type": "duration", "fast": { "$value": { "value": 150, "unit": "ms" } }, "sheet": { "$value": { "value": 240, "unit": "ms" } } },
  "font": {
    "$type": "fontFamily",
    "sans":   { "$value": ["Inter", "Alexandria", "system-ui", "sans-serif"] },
    "arabic": { "$value": ["Lusail", "Inter", "Alexandria", "IBM Plex Sans Arabic", "system-ui", "sans-serif"] },
    "mono":   { "$value": ["JetBrains Mono", "Lusail", "ui-monospace", "monospace"] }
  }
}
