{
  "$description": "Semantic layer, dark theme (navy, never black). Surfaces step bg < surface < surface-raised < surface-overlay; hover/selected are derived fg overlays (build.mjs). Status hues (success/warning/danger/info) never change per brand and never equal the brand accent.",
  "semantic": {
    "$type": "color",
    "bg":                { "$value": "{color.ink.950}" },
    "surface":           { "$value": "{color.ink.900}" },
    "surface-raised":    { "$value": "{color.ink.875}" },
    "surface-overlay":   { "$value": "{color.ink.825}" },
    "surface-soft":      { "$value": "{color.ink.800}" },
    "line":              { "$value": "{color.ink.700}" },
    "line-strong":       { "$value": "{color.ink.500}" },
    "fg":                { "$value": "{color.ivory.200}" },
    "fg-body":           { "$value": "{color.ink.300}" },
    "fg-muted":          { "$value": "{color.ink.500}" },
    "accent":            { "$value": "{color.gold.500}" },
    "accent-text":       { "$value": "{color.gold.500}" },
    "focus":             { "$value": "{color.ivory.200}" },
    "success":           { "$value": "{color.green.500}" },
    "success-text":      { "$value": "{color.green.300}" },
    "warning":           { "$value": "{color.amber.500}" },
    "warning-text":      { "$value": "{color.amber.300}" },
    "danger":            { "$value": "{color.red.500}" },
    "danger-text":       { "$value": "{color.red.300}" },
    "danger-solid":      { "$value": "{color.red.300}" },
    "on-danger":         { "$value": "{color.ink.950}" },
    "info":              { "$value": "{color.blue.500}" },
    "info-text":         { "$value": "{color.blue.300}" }
  }
}
