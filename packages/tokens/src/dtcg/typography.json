{
  "$description": "Typography roles (docs/ARCHITECTURE.md section 9). Latin and Arabic have separate metrics. Weights 300/400/500 only; floor 12px (eyebrow is uppercase mono at 11px, Latin only).",
  "type": {
    "$type": "number",
    "latin": {
      "display": { "size": { "$value": 40 }, "line": { "$value": 1.1 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h1":      { "size": { "$value": 30 }, "line": { "$value": 1.2 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h2":      { "size": { "$value": 24 }, "line": { "$value": 1.25 }, "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h3":      { "size": { "$value": 19 }, "line": { "$value": 1.3 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "body":    { "size": { "$value": 15 }, "line": { "$value": 1.55 }, "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "body-sm": { "size": { "$value": 13 }, "line": { "$value": 1.5 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "label":   { "size": { "$value": 13 }, "line": { "$value": 1.3 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "caption": { "size": { "$value": 12 }, "line": { "$value": 1.4 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "eyebrow": { "size": { "$value": 11 }, "line": { "$value": 1.4 },  "weight": { "$value": 500 }, "tracking": { "$value": 0.14 } },
      "code":    { "size": { "$value": 13 }, "line": { "$value": 1.5 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } }
    },
    "arabic": {
      "display": { "size": { "$value": 40 }, "line": { "$value": 1.5 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h1":      { "size": { "$value": 30 }, "line": { "$value": 1.6 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h2":      { "size": { "$value": 24 }, "line": { "$value": 1.6 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "h3":      { "size": { "$value": 20 }, "line": { "$value": 1.7 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "body":    { "size": { "$value": 16 }, "line": { "$value": 1.85 }, "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "body-sm": { "size": { "$value": 14 }, "line": { "$value": 1.8 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "label":   { "size": { "$value": 14 }, "line": { "$value": 1.6 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "caption": { "size": { "$value": 13 }, "line": { "$value": 1.7 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } },
      "eyebrow": { "size": { "$value": 13 }, "line": { "$value": 1.7 },  "weight": { "$value": 500 }, "tracking": { "$value": 0 } },
      "code":    { "size": { "$value": 13 }, "line": { "$value": 1.5 },  "weight": { "$value": 400 }, "tracking": { "$value": 0 } }
    }
  }
}
