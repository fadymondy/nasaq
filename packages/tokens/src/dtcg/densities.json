{
  "$description": "Density changes sizes, never hierarchy or type scale.",
  "density": {
    "$type": "dimension",
    "comfortable": { "control": { "$value": { "value": 40, "unit": "px" } }, "control-sm": { "$value": { "value": 32, "unit": "px" } }, "row": { "$value": { "value": 48, "unit": "px" } }, "nav-row": { "$value": { "value": 36, "unit": "px" } }, "page-pad": { "$value": { "value": 28, "unit": "px" } }, "control-pad": { "$value": { "value": 16, "unit": "px" } }, "header": { "$value": { "value": 56, "unit": "px" } }, "shell-pad": { "$value": { "value": 16, "unit": "px" } } },
    "compact":     { "control": { "$value": { "value": 32, "unit": "px" } }, "control-sm": { "$value": { "value": 28, "unit": "px" } }, "row": { "$value": { "value": 40, "unit": "px" } }, "nav-row": { "$value": { "value": 32, "unit": "px" } }, "page-pad": { "$value": { "value": 24, "unit": "px" } }, "control-pad": { "$value": { "value": 12, "unit": "px" } }, "header": { "$value": { "value": 48, "unit": "px" } }, "shell-pad": { "$value": { "value": 12, "unit": "px" } } },
    "dense":       { "control": { "$value": { "value": 28, "unit": "px" } }, "control-sm": { "$value": { "value": 24, "unit": "px" } }, "row": { "$value": { "value": 32, "unit": "px" } }, "nav-row": { "$value": { "value": 28, "unit": "px" } }, "page-pad": { "$value": { "value": 16, "unit": "px" } }, "control-pad": { "$value": { "value": 8, "unit": "px" } }, "header": { "$value": { "value": 40, "unit": "px" } }, "shell-pad": { "$value": { "value": 8, "unit": "px" } } }
  }
}
