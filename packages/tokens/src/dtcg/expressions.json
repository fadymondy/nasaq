{
  "$description": "Expression layer: geometry and texture over one token core. grid = square, hairline, hatch (web default). native = rounded, no hatch (desktop, mobile, extension).",
  "expression": {
    "grid": {
      "radius": { "$type": "dimension", "surface": { "$value": { "value": 0, "unit": "px" } }, "card": { "$value": { "value": 0, "unit": "px" } }, "control": { "$value": { "value": 6, "unit": "px" } }, "floating": { "$value": { "value": 12, "unit": "px" } } },
      "hatch": { "$type": "number", "$value": 1 }
    },
    "native": {
      "radius": { "$type": "dimension", "surface": { "$value": { "value": 0, "unit": "px" } }, "card": { "$value": { "value": 10, "unit": "px" } }, "control": { "$value": { "value": 8, "unit": "px" } }, "floating": { "$value": { "value": 12, "unit": "px" } } },
      "hatch": { "$type": "number", "$value": 0 }
    }
  }
}
