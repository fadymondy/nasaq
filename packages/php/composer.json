{
    "name": "fadymondy/nasaq-php",
    "description": "Nasaq design system for Laravel: Blade components (<x-nq::button>), Alpine behaviours and a FilamentPHP plugin. Same markup and Tailwind classes as the React components.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "blade", "filament", "livewire", "alpinejs", "tailwindcss", "design-system", "rtl", "arabic", "shadcn"],
    "homepage": "https://nasaq-ui.fadymondy.com",
    "authors": [{ "name": "Fady Mondy", "homepage": "https://fadymondy.com" }],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "mallardduck/blade-lucide-icons": "^1.23"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "filament/filament": "Register NasaqPlugin on a panel to load the styles and Alpine behaviours"
    },
    "autoload": {
        "psr-4": { "Nasaq\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Nasaq\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Nasaq\\NasaqServiceProvider"] }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
