{
  "name": "@nasaq/feedback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Mahaam feedback reporter on Nasaq components: the vendored @mahaam/feedback-core plus a Nasaq-built dialog and launcher.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "node ../tooling/src/lint.mjs src/react src/mahaam.ts src/index.ts",
    "sync": "node scripts/sync-feedback.mjs",
    "check:sync": "node scripts/sync-feedback.mjs --check"
  },
  "dependencies": {
    "@nasaq/web": "workspace:*",
    "html-to-image": "1.11.13",
    "lucide-react": "1.48.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
