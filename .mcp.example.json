{
  "mcpServers": {
    "zekra": {
      "type": "http",
      "url": "https://mcp.zekra.dev",
      "headers": {
        "X-Zekra-Namespace": "nasaq",
        "X-Zekra-Token": "<your Zekra brain token — never commit it>"
      }
    },
    "nasaq": {
      "type": "stdio",
      "command": "node",
      "args": [
        "packages/mcp/src/server.mjs"
      ]
    }
  }
}
